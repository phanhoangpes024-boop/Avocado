---
import Layout from "../layouts/Layout.astro";
import BentoGrid from "../components/BentoGrid.astro";
import { toolGridItems } from "../data/toolGridConfig";
import QRGenerator from "../components/tool/QRGenerator.astro";
import ImageEditor from "../components/tool/ImageEditor.astro";
---

<Layout title="Tools - Hector's Lab">
  <div class="portfolio-wrapper">
    <button class="close-btn" id="close-btn" aria-label="Quay về">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="portfolio-container">
      <h1 class="tool-title">Hector's Lab</h1>
      <p class="tool-subtitle">Công cụ phát triển</p>
      <BentoGrid items={toolGridItems} />
    </div>

    <div class="transition-overlay" id="transition-overlay"></div>
  </div>
  <QRGenerator />
  <ImageEditor />
</Layout>

<style>
  /* Wrapper giống trang chủ */
  .portfolio-wrapper {
    width: 100%;
    min-height: 100vh;
    overflow-y: scroll;
    overflow-x: hidden;
    padding: 24px 8px;
    position: relative;
  }

  /* Ẩn scrollbar */
  .portfolio-wrapper::-webkit-scrollbar {
    display: none;
  }

  .portfolio-wrapper {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Container giống trang chủ */
  .portfolio-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 16px 0;
  }

  @media (max-width: 900px) {
    .portfolio-container {
      padding: 60px 8px 0;
    }
  }

  @media (max-width: 600px) {
    .portfolio-container {
      padding: 60px 4px 0;
    }
    
    .portfolio-wrapper {
      padding: 24px 4px;
    }
  }

  /* Close button */
  .close-btn {
    position: fixed;
    top: 24px;
    right: 24px;
    width: 48px;
    height: 48px;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 1000;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .close-btn:hover {
    background: #111827;
    border-color: #111827;
    transform: rotate(90deg) scale(1.1);
  }

  .close-btn:hover svg {
    stroke: white;
  }

  /* Title */
  .tool-title {
    font-size: 42px;
    font-weight: 800;
    color: #1f2937;
    text-align: center;
    margin: 0 0 8px 0;
  }

  .tool-subtitle {
    font-size: 18px;
    color: #6b7280;
    text-align: center;
    margin: 0 0 48px 0;
  }

  /* Transition overlay */
  .transition-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #000000;
    opacity: 0;
    pointer-events: none;
    z-index: 9999;
    transition: opacity 0.5s ease;
  }

  .transition-overlay.active {
    opacity: 1;
    pointer-events: all;
  }

  /* Dark mode */
  :global(body.dark-mode) .close-btn {
    background: #1a1a1a;
    border-color: #333333;
  }

  :global(body.dark-mode) .tool-title {
    color: #ffffff;
  }

  :global(body.dark-mode) .tool-subtitle {
    color: #9ca3af;
  }

  /* Responsive */
  @media (max-width: 600px) {
    .tool-title {
      font-size: 28px;
    }

    .tool-subtitle {
      font-size: 16px;
    }

    .close-btn {
      width: 40px;
      height: 40px;
      top: 16px;
      right: 16px;
    }
  }

  /* Fade out animation */
  .fade-out {
    animation: fadeOut 0.5s ease forwards;
  }

  @keyframes fadeOut {
    to {
      opacity: 0;
      transform: translateY(-20px);
    }
  }
</style>

<script>
  const closeBtn = document.getElementById('close-btn');
  const toolContainer = document.querySelector('.portfolio-container') as HTMLElement;
  const overlay = document.getElementById('transition-overlay');

  closeBtn?.addEventListener('click', () => {
    toolContainer?.classList.add('fade-out');
    closeBtn.classList.add('fade-out');
    setTimeout(() => overlay?.classList.add('active'), 300);
    setTimeout(() => window.location.href = '/', 800);
  });
</script>