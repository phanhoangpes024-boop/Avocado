---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

  <link rel="preconnect" href="https://api.lanyard.rest" />
  <link rel="preconnect" href="https://tile.openstreetmap.org" />
  <link rel="dns-prefetch" href="https://threads-gamma-five.vercel.app" />
  <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />
    
    <!-- PRELOAD: Ảnh quan trọng nhất load trước -->
    <link rel="preload" as="image" href="/avatar-large.webp" media="(min-width: 900px)" />
    <link rel="preload" as="image" href="/avatar-medium.webp" media="(min-width: 600px) and (max-width: 899px)" />
    <link rel="preload" as="image" href="/avatar-small.webp" media="(max-width: 599px)" />
    
    <!-- CSS của Leaflet -->
    <link rel="stylesheet" href="/leaflet.css" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>