---
interface Props {
  lottieFile?: string;
  buttonText?: string;
  toolLink?: string;
  title?: string;
  subtitle?: string;
}

const { 
  lottieFile = "/gear.lottie",
  buttonText = "Mở kho đồ nghề",
  toolLink = "/tool",
  title = "MY TOOL",
  subtitle = "Tạo mã QR, resize ảnh và nhiều hơn"
} = Astro.props;
---

<div class="card tool-card group">
  
  <div class="card-header">
    <div class="icon-box">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
      </svg>
    </div>
    <div class="header-text">
      <span class="main-title">{title}</span>
      <span class="sub-label">{subtitle}</span>
    </div>
  </div>

  <div class="lottie-wrapper">
    <dotlottie-player
      src={lottieFile}
      background="transparent"
      speed="1"
      class="lottie-player"
      loop
      autoplay>
    </dotlottie-player>
  </div>
  
  <a href={toolLink} class="action-btn">
    <span>{buttonText}</span>
    <svg class="arrow-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
    </svg>
  </a>

</div>

<style>
  /* === LAYOUT CHÍNH === */
  .card {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 240px;
    background: #ffffff;
    border-radius: 24px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid #f3f4f6;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    overflow: hidden;
    cursor: grab;
  }

  .card:active {
    cursor: grabbing;
  }

  /* Hover Card */
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.1);
    border-color: #e5e7eb;
  }

  /* === 1. HEADER === */
  .card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 10; /* Nằm trên Lottie */
    position: relative;
  }

  .icon-box {
    width: 36px;
    height: 36px;
    background: #eff6ff;
    color: #2563eb;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .card:hover .icon-box {
    transform: rotate(15deg) scale(1.1);
  }

  .header-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .main-title {
    font-size: 14px;
    font-weight: 800;
    color: #1f2937;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .sub-label {
    font-size: 12px;
    color: #6b7280;
    font-weight: 500;
  }

  /* === 2. LOTTIE === */
  .lottie-wrapper {
    position: absolute; /* Đặt ở lớp dưới cùng */
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 0; /* Nằm dưới Header và Button */
    pointer-events: none; /* Không chặn tương tác chuột */
  }

  .lottie-player {
    width: 100%;
    height: 100%;
    transition: transform 0.5s ease;
  }

  .card:hover .lottie-player {
    transform: scale(1.05);
  }

  /* === 3. BUTTON - EXPANDABLE === */
  .action-btn {
    position: relative;
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    gap: 0; /* Ban đầu không có gap */
    padding: 12px; /* Hình tròn ban đầu */
    background: #e5e7eb;
    color: #374151;
    font-size: 13px;
    font-weight: 600;
    border-radius: 50px; /* Bo tròn hoàn toàn */
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 10;
    overflow: hidden;
    white-space: nowrap;
  }

  /* Text ẩn ban đầu */
  .action-btn span {
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .arrow-icon {
    transition: transform 0.3s ease;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* Hover: Mở rộng ra */
  .action-btn:hover {
    background: #111827;
    color: #ffffff;
    padding: 10px 18px 10px 12px; /* Padding bất đối xứng khi mở rộng */
    gap: 8px; /* Tạo khoảng cách giữa text và icon */
  }

  .action-btn:hover span {
    max-width: 150px; /* Cho phép text hiện ra */
    opacity: 1;
    margin-left: 4px;
  }

  .action-btn:hover .arrow-icon {
    transform: translateX(2px);
  }

  /* === DARK MODE === */
  :global(body.dark-mode) .card {
    background: #1f2937;
    border-color: #374151;
  }

  :global(body.dark-mode) .main-title {
    color: #ffffff;
  }

  :global(body.dark-mode) .sub-label {
    color: #9ca3af;
  }

  :global(body.dark-mode) .icon-box {
    background: #374151;
    color: #60a5fa;
  }

  :global(body.dark-mode) .action-btn {
    background: #374151;
    color: #e5e7eb;
  }

  :global(body.dark-mode) .action-btn:hover {
    background: #ffffff;
    color: #000000;
  }

  /* === RESPONSIVE === */
  @media (max-width: 600px) {
    .card {
      padding: 16px;
      min-height: 200px;
    }

    .icon-box {
      width: 32px;
      height: 32px;
    }

    .icon-box svg {
      width: 16px;
      height: 16px;
    }

    .main-title {
      font-size: 12px;
    }

    .sub-label {
      font-size: 10px;
    }

    /* ✅ Lottie vẫn chiếm 100% ở mobile */
    .lottie-wrapper {
      width: 100%;
      height: 100%;
    }

    .lottie-player {
      width: 100%;
      height: 100%;
    }

    .action-btn {
      padding: 10px; /* Hình tròn nhỏ hơn trên mobile */
      font-size: 12px;
    }
    
    .action-btn:hover {
      padding: 8px 14px 8px 10px;
    }
    
    .arrow-icon {
      width: 14px;
      height: 14px;
    }
    
    .action-btn:hover span {
      max-width: 120px; /* Text ngắn hơn trên mobile */
    }
  }

  @media (min-width: 601px) and (max-width: 900px) {
    .card {
      padding: 18px;
      min-height: 220px;
    }

    .icon-box {
      width: 34px;
      height: 34px;
    }

    .main-title {
      font-size: 13px;
    }

    .sub-label {
      font-size: 11px;
    }

    /* ✅ Lottie vẫn chiếm 100% ở tablet */
    .lottie-wrapper {
      width: 100%;
      height: 100%;
    }

    .lottie-player {
      width: 100%;
      height: 100%;
    }

    .action-btn {
      padding: 11px;
      font-size: 12px;
    }
    
    .action-btn:hover {
      padding: 9px 16px 9px 11px;
    }
    
    .arrow-icon {
      width: 15px;
      height: 15px;
    }
    
    .action-btn:hover span {
      max-width: 130px;
    }
  }
</style>

<script>
  // Load thư viện dotlottie player
  import('https://unpkg.com/@dotlottie/player-component@latest/dist/dotlottie-player.mjs');
</script>