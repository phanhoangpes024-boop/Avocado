---
import type { GridItem } from "../types/grid";
import BentoItem from "./BentoItem.astro";
import CardIntro from "./CardIntro.astro";
import CardBlog from "./CardBlog.astro";
import CardSpotify from "./CardSpotify.astro";
import CardTwitter from "./CardTwitter.astro";
import CardMap from "./CardMap.astro";
import CardProject from "./CardProject.astro";
import CardDarkMode from "./CardDarkMode.astro";
import CardNewsletter from "./CardNewsletter.astro";

interface Props {
  items: GridItem[];
}

const { items } = Astro.props;
---

<div class="bento-grid" id="bento-grid">
  {items.map((item) => (
    <BentoItem id={item.id} size={item.size}>
      {item.type === "intro" && (
        <CardIntro emoji={item.emoji} name={item.name} title={item.title} bio={item.bio} buttonText={item.buttonText} />
      )}
      {item.type === "blog" && (
        <CardBlog title={item.title} description={item.description} date={item.date} link={item.link} />
      )}
      {item.type === "spotify" && (
        <CardSpotify status={item.status} song={item.song} artist={item.artist} />
      )}
      {item.type === "twitter" && <CardTwitter link={item.link} />}
      {item.type === "map" && <CardMap emoji={item.emoji} location={item.location} />}
      {item.type === "project" && (
        <CardProject emoji={item.emoji} name={item.name} theme={item.theme} link={item.link} />
      )}
      {item.type === "darkmode" && <CardDarkMode />}
      {item.type === "newsletter" && (
        <CardNewsletter title={item.title} placeholder={item.placeholder} buttonText={item.buttonText} subscriberCount={item.subscriberCount} />
      )}
    </BentoItem>
  ))}
</div>

<script>
  import Muuri from "muuri";

  let grid: Muuri | null = null;

  function initMuuri() {
    const el = document.getElementById("bento-grid");
    if (!el) return;

    grid = new Muuri(el, {
      dragEnabled: true,
      dragStartPredicate: { distance: 0, delay: 0 },
      dragSortPredicate: { threshold: 40, action: "swap" },
      layout: { fillGaps: true, horizontal: false, alignRight: false, alignBottom: false, rounding: true },
      layoutDuration: 400,
      layoutEasing: "cubic-bezier(0.25, 0.1, 0.25, 1)",
      dragRelease: { duration: 300, easing: "ease-out", useDragContainer: true },
      dragPlaceholder: {
        enabled: true,
        createElement: (item) => {
          const el = item.getElement();
          if (!el) return document.createElement("div");
          const p = el.cloneNode(true) as HTMLElement;
          p.style.opacity = "0.3";
          return p;
        }
      },
      dragContainer: document.body,
      dragSortHeuristics: { sortInterval: 50, minDragDistance: 10, minBounceBackAngle: 1 }
    });

    loadOrder();
    grid.on("dragEnd", () => { saveOrder(); grid?.layout(true); });
  }

  function saveOrder() {
    if (!grid) return;
    const order = grid.getItems().map((i) => i.getElement()?.dataset.id || "");
    localStorage.setItem("bentoGridOrder", JSON.stringify(order));
  }

  function loadOrder() {
    const saved = localStorage.getItem("bentoGridOrder");
    if (!saved || !grid) return;
    try {
      const order: string[] = JSON.parse(saved);
      const items = grid.getItems();
      const sorted = order.map((id) => items.find((i) => i.getElement()?.dataset.id === id)).filter((i): i is Muuri.Item => !!i);
      if (sorted.length === items.length) grid.sort(sorted, { layout: "instant" });
    } catch (e) { console.error(e); }
  }

  document.readyState === "loading" ? document.addEventListener("DOMContentLoaded", initMuuri) : initMuuri();
</script>
