---
interface Props {
  id: string;
  name: string;
  lottieFile: string;
}

const { id, name, lottieFile } = Astro.props;
---

<div class="mini-tool-card" data-tool-id={id}>
  <!-- Lottie Animation -->
  <div class="lottie-container">
    <dotlottie-player
      src={lottieFile}
      background="transparent"
      speed="1"
      class="lottie-animation"
      loop
      autoplay>
    </dotlottie-player>
  </div>

  <!-- Tool Name -->
  <h3 class="tool-name">{name}</h3>

  <!-- Action Button -->
  <button class="open-tool-btn" data-tool-id={id}>
    <svg class="btn-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
    </svg>
  </button>
</div>

<style>
  /* === CARD CONTAINER === */
  .mini-tool-card {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 240px;
    background: #ffffff;
    border-radius: 24px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    border: 1px solid #f3f4f6;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    overflow: hidden;
    cursor: grab;
  }

  .mini-tool-card:active {
    cursor: grabbing;
  }

  .mini-tool-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.1);
    border-color: #e5e7eb;
  }

  /* === LOTTIE CONTAINER === */
  .lottie-container {
    flex: 1;
    width: 100%;
    max-width: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lottie-animation {
    width: 100%;
    height: 100%;
    max-height: 140px;
    transition: transform 0.5s ease;
  }

  .mini-tool-card:hover .lottie-animation {
    transform: scale(1.05);
  }

  /* === TOOL NAME === */
  .tool-name {
    font-size: 16px;
    font-weight: 700;
    color: #1f2937;
    text-align: center;
    margin: 0;
    letter-spacing: 0.02em;
  }

  /* === ACTION BUTTON === */
  .open-tool-btn {
    width: 44px;
    height: 44px;
    background: #e5e7eb;
    color: #374151;
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
  }

  .btn-icon {
    transition: transform 0.3s ease;
  }

  .open-tool-btn:hover {
    background: #111827;
    color: #ffffff;
    transform: scale(1.1);
  }

  .open-tool-btn:hover .btn-icon {
    transform: translateX(3px);
  }

  .open-tool-btn:active {
    transform: scale(0.95);
  }

  /* === DARK MODE === */
  :global(body.dark-mode) .mini-tool-card {
    background: #1f2937;
    border-color: #374151;
  }

  :global(body.dark-mode) .tool-name {
    color: #ffffff;
  }

  :global(body.dark-mode) .open-tool-btn {
    background: #374151;
    color: #e5e7eb;
  }

  :global(body.dark-mode) .open-tool-btn:hover {
    background: #ffffff;
    color: #000000;
  }

  /* === RESPONSIVE === */
  @media (max-width: 600px) {
    .mini-tool-card {
      padding: 16px;
      min-height: 200px;
      gap: 12px;
    }

    .lottie-container {
      max-width: 100px;
    }

    .lottie-animation {
      max-height: 100px;
    }

    .tool-name {
      font-size: 14px;
    }

    .open-tool-btn {
      width: 38px;
      height: 38px;
    }

    .btn-icon {
      width: 16px;
      height: 16px;
    }
  }

  @media (min-width: 601px) and (max-width: 900px) {
    .mini-tool-card {
      padding: 18px;
      min-height: 220px;
      gap: 14px;
    }

    .lottie-container {
      max-width: 120px;
    }

    .lottie-animation {
      max-height: 120px;
    }

    .tool-name {
      font-size: 15px;
    }

    .open-tool-btn {
      width: 40px;
      height: 40px;
    }
  }
</style>

<script>
  // Load thư viện dotlottie player
  import('https://unpkg.com/@dotlottie/player-component@latest/dist/dotlottie-player.mjs');

  // Xử lý click button - sẽ mở popup
  function initMiniToolButtons() {
    document.querySelectorAll('.open-tool-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const toolId = (btn as HTMLElement).dataset.toolId;
        
        // Dispatch custom event để mở popup
        const event = new CustomEvent('openToolPopup', { 
          detail: { toolId },
          bubbles: true 
        });
        document.dispatchEvent(event);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMiniToolButtons);
  } else {
    initMiniToolButtons();
  }
</script>