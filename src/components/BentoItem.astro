---
import type { ItemSize } from "../types/grid";

interface Props {
  id: string;
  size: ItemSize;
  class?: string;
}

const { id, size, class: className = "" } = Astro.props;

const sizeClasses: Record<ItemSize, string> = {
  large: "item-large",
  wide: "item-wide",
  small: "item-small",
  tall: "item-tall"
};
---

<div class:list={["bento-item", sizeClasses[size], className]} data-id={id}>
  <slot />
</div>

<style>
  .item-large {
    width: calc(50% - 20px);
    height: 420px;
  }
  .item-wide {
    width: calc(50% - 20px);
    height: 200px;
  }
  .item-small {
    width: calc(25% - 20px);
    height: 200px;
  }
  .item-tall {
    width: calc(25% - 20px);
    height: 420px;
  }

  @media (max-width: 1024px) {
    .item-large { width: calc(100% - 20px); height: 400px; }
    .item-wide { width: calc(100% - 20px); height: 200px; }
    .item-small { width: calc(50% - 20px); height: 200px; }
    .item-tall { width: calc(50% - 20px); height: 420px; }
  }

  @media (max-width: 768px) {
    .item-large, .item-wide, .item-small, .item-tall {
      width: calc(100% - 20px);
      height: auto;
      min-height: 200px;
    }
  }
</style>
