---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  logo: string;
  nav: NavItem[];
}

const { logo, nav } = Astro.props;
---

<header class="header">
  <img src="/logolight.png" alt="Logo" class="logo-img" id="logo-img" />
  <nav class="nav">
    {nav.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>
</header>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding: 0 8px;
  }

  .logo-img {
    height: 150px;
    width: 150px;
    transition: opacity 0.3s;
  }

  .nav {
    display: flex;
    gap: 32px;
  }

  .nav a {
    color: #94a3b8;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav a:hover {
    color: #f8fafc;
  }
</style>

<script>
  const logoImg = document.getElementById("logo-img") as HTMLImageElement;
  let isDark = localStorage.getItem("darkMode") === "true";

  function updateLogo() {
    if (logoImg) {
      logoImg.src = isDark ? "/logodark.png" : "/logolight.png";
    }
  }

  updateLogo();

  // Lắng nghe sự kiện darkmode toggle
  const observer = new MutationObserver(() => {
    isDark = document.body.classList.contains("dark-mode");
    updateLogo();
  });

  observer.observe(document.body, { attributes: true, attributeFilter: ["class"] });
</script>