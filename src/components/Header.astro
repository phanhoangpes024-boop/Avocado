---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  logo: string;
  nav: NavItem[];
}

const { logo, nav } = Astro.props;
---

<header class="header">
  <!-- RESPONSIVE LOGO với width/height -->
  <img 
    src="/logolight.webp" 
    alt="Logo" 
    class="logo-img" 
    id="logo-img"
    width="150"
    height="75"
    loading="eager"
    fetchpriority="high"
  />
  <nav class="nav">
    {nav.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>
</header>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding: 0;
  }

  /* Desktop: Căn Header với BentoGrid */
  @media (min-width: 900px) {
    .header {
      max-width: 1134px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  .logo-img {
    height: 75px;
    width: 150px;
    transition: opacity 0.3s;
  }

  .nav {
    display: flex;
    gap: 32px;
  }

  .nav a {
    color: #94a3b8;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav a:hover {
    color: #f8fafc;
  }

  /* Responsive: Mobile & Tablet */
  @media (max-width: 900px) {
    .header {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 16px;
    }

    .logo-img {
      height: 80px;
      width: 160px;
    }

    .nav {
      gap: 24px;
    }

    .nav a {
      font-size: 14px;
    }
  }

  @media (max-width: 600px) {
    .logo-img {
      height: 75px;
      width: 150px;
    }

    .nav {
      gap: 16px;
    }

    .nav a {
      font-size: 13px;
    }
  }
</style>

<script>
  // THAY THẾ TOÀN BỘ PHẦN <script> TRONG Header.astro

const logoImg = document.getElementById("logo-img") as HTMLImageElement;
let isDark = localStorage.getItem("darkMode") === "true";

function updateLogo() {
  if (logoImg) {
    logoImg.src = isDark ? "/logodark.webp" : "/logolight.webp";
  }
}

updateLogo();

// Lắng nghe sự kiện darkmode toggle
const observer = new MutationObserver(() => {
  isDark = document.body.classList.contains("dark-mode");
  updateLogo();
});

observer.observe(document.body, { attributes: true, attributeFilter: ["class"] });

// ===== ABOUT MODE FUNCTIONALITY =====
function initAboutMode() {
  const aboutLink = document.querySelector('a[href="#about"]');
  
  if (!aboutLink) {
    console.log('About link not found');
    return;
  }
  
  // Tạo overlay và nút đóng
  const overlay = document.createElement('div');
  overlay.className = 'about-overlay';
  overlay.id = 'about-overlay';
  document.body.appendChild(overlay);
  
  const closeBtn = document.createElement('button');
  closeBtn.className = 'close-about-btn';
  closeBtn.setAttribute('aria-label', 'Đóng');
  closeBtn.innerHTML = `
    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  `;
  document.body.appendChild(closeBtn);
  
  // Đánh dấu 3 card đặc biệt
  const featuredCards = ['intro', 'map', 'twitter'];
  featuredCards.forEach(id => {
    const card = document.querySelector(`[data-id="${id}"]`);
    if (card) {
      card.classList.add('about-featured');
    }
  });
  
  // Click About
  aboutLink.addEventListener('click', (e) => {
    e.preventDefault();
    console.log('About clicked');
    document.body.classList.add('about-mode');
    overlay.classList.add('active');
  });
  
  // Đóng About
  function closeAbout() {
    console.log('Closing about');
    document.body.classList.remove('about-mode');
    overlay.classList.remove('active');
  }
  
  closeBtn.addEventListener('click', closeAbout);
  overlay.addEventListener('click', closeAbout);
  
  // ESC để đóng
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.body.classList.contains('about-mode')) {
      closeAbout();
    }
  });
  
  console.log('About mode initialized');
}

// Chạy khi DOM sẵn sàng
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initAboutMode);
} else {
  initAboutMode();
}
</script>