---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  logo: string;
  nav: NavItem[];
}

const { logo, nav } = Astro.props;
---

<header class="header">
  <!-- RESPONSIVE LOGO với width/height -->
  <img 
    src="/logolight.webp" 
    alt="Logo" 
    class="logo-img" 
    id="logo-img"
    width="150"
    height="75"
    loading="eager"
  />
  <nav class="nav">
    {nav.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>
</header>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding: 0;
  }

  /* Desktop: Căn Header với BentoGrid */
  @media (min-width: 900px) {
    .header {
      max-width: 1134px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  .logo-img {
    height: 75px;
    width: 150px;
    transition: opacity 0.3s;
  }

  .nav {
    display: flex;
    gap: 32px;
  }

  .nav a {
    color: #94a3b8;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav a:hover {
    color: #f8fafc;
  }

  /* Responsive: Mobile & Tablet */
  @media (max-width: 900px) {
    .header {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 16px;
    }

    .logo-img {
      height: 80px;
      width: 160px;
    }

    .nav {
      gap: 24px;
    }

    .nav a {
      font-size: 14px;
    }
  }

  @media (max-width: 600px) {
    .logo-img {
      height: 75px;
      width: 150px;
    }

    .nav {
      gap: 16px;
    }

    .nav a {
      font-size: 13px;
    }
  }
</style>

<script>
  const logoImg = document.getElementById("logo-img") as HTMLImageElement;
  let isDark = localStorage.getItem("darkMode") === "true";

  function updateLogo() {
    if (logoImg) {
      logoImg.src = isDark ? "/logodark.webp" : "/logolight.webp";
    }
  }

  updateLogo();

  // Lắng nghe sự kiện darkmode toggle
  const observer = new MutationObserver(() => {
    isDark = document.body.classList.contains("dark-mode");
    updateLogo();
  });

  observer.observe(document.body, { attributes: true, attributeFilter: ["class"] });
</script>