---
interface Props {
  emoji: string;
  location?: string;
}

const { emoji, location } = Astro.props;
---

<div class="bento-item-content map-card">
  <svg class="map-lines" viewBox="0 0 200 200">
    <line x1="0" y1="50" x2="200" y2="50" stroke="#9ca3af" stroke-width="1"/>
    <line x1="0" y1="100" x2="200" y2="100" stroke="#9ca3af" stroke-width="1"/>
    <line x1="0" y1="150" x2="200" y2="150" stroke="#9ca3af" stroke-width="1"/>
    <line x1="50" y1="0" x2="50" y2="200" stroke="#9ca3af" stroke-width="1"/>
    <line x1="100" y1="0" x2="100" y2="200" stroke="#9ca3af" stroke-width="1"/>
    <line x1="150" y1="0" x2="150" y2="200" stroke="#9ca3af" stroke-width="1"/>
  </svg>
  <div class="map-marker">{emoji}</div>
  {location && <span class="map-location">{location}</span>}
</div>

<style>
  .map-location {
    position: absolute;
    bottom: 16px;
    left: 16px;
    font-size: 12px;
    color: #4a5568;
    font-weight: 500;
  }
</style>
