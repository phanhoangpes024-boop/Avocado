---
interface Props {
  emoji: string;
  location?: string;
  lat: number;
  lng: number;
  zoom?: number;
}

const { location, lat, lng, zoom = 15 } = Astro.props;
const mapId = `map-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="card">
  <div class="map-container" id={mapId} data-lat={lat} data-lng={lng} data-zoom={zoom}></div>
  
  <!-- Lớp che để chặn tương tác với map khi drag -->
  <div class="map-overlay"></div>
  
  <div class="avatar-marker">
    <img src="/avatar.png" alt="Location" />
  </div>
  
  {location && <span class="location">{location}</span>}
  
  <div class="zoom-controls">
    <button class="zoom-btn zoom-in" data-map={mapId} aria-label="Zoom in">+</button>
    <button class="zoom-btn zoom-out" data-map={mapId} aria-label="Zoom out">−</button>
  </div>
</div>

<style>
  .card {
    position: relative;
    width: 100%;
    height: 100%;
    background: #e5e7eb;
    border-radius: 24px;
    overflow: hidden;
    cursor: grab;
  }

  .card:active { 
    cursor: grabbing; 
  }

  .map-container {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  /* Ẩn logo Leaflet */
  .card :global(.leaflet-control-attribution) {
    display: none;
  }

  .card :global(.leaflet-control-zoom) {
    display: none;
  }

  /* ===== LỚP CHE CHẶN TƯƠNG TÁC MAP ===== */
  .map-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    cursor: grab;
    /* Luôn hiển thị ở mọi thiết bị */
  }

  .map-overlay:active {
    cursor: grabbing;
  }

  .avatar-marker {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 3px solid white;
    background: rgba(102, 126, 234, 0.2);
    box-shadow: 0 0 0 8px rgba(102, 126, 234, 0.15),
                0 2px 8px rgba(0,0,0,0.15);
    z-index: 3;
    pointer-events: none;
    overflow: hidden;
  }

  .avatar-marker img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .location {
    position: absolute;
    bottom: 16px;
    left: 16px;
    font-size: 13px;
    color: #1a1a1a;
    font-weight: 600;
    background: white;
    padding: 8px 14px;
    border-radius: 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    z-index: 4;
  }

  .zoom-controls {
    position: absolute;
    bottom: 16px;
    right: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 4;
  }

  .zoom-btn {
    width: 44px;
    height: 44px;
    background: white;
    border: none;
    border-radius: 12px;
    font-size: 24px;
    font-weight: 600;
    color: #1a1a1a;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
  }

  .zoom-btn:hover {
    background: #f3f4f6;
    transform: scale(1.05);
  }

  .zoom-btn:active {
    transform: scale(0.95);
  }

  /* ===== RESPONSIVE: MOBILE/TABLET ===== */
  @media (max-width: 600px) {
    .avatar-marker {
      width: 32px;
      height: 32px;
      border-width: 2px;
      box-shadow: 0 0 0 6px rgba(102, 126, 234, 0.15),
                  0 2px 6px rgba(0,0,0,0.15);
    }

    .location {
      font-size: 11px;
      padding: 6px 12px;
      bottom: 12px;
      left: 12px;
    }

    .zoom-controls {
      bottom: 12px;
      right: 12px;
    }

    .zoom-btn {
      width: 38px;
      height: 38px;
      font-size: 20px;
    }
  }


</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  function initAllMaps() {
    const mapContainers = document.querySelectorAll('.map-container');
    
    mapContainers.forEach((mapEl) => {
      if ((mapEl as any).dataset.initialized === 'true') return;
      
      const lat = parseFloat((mapEl as HTMLElement).dataset.lat || '0');
      const lng = parseFloat((mapEl as HTMLElement).dataset.lng || '0');
      const zoom = parseInt((mapEl as HTMLElement).dataset.zoom || '15');

      const map = L.map(mapEl as HTMLElement, {
        center: [lat, lng],
        zoom: zoom,
        zoomControl: false,
        dragging: true,
        scrollWheelZoom: false,
        doubleClickZoom: true,
        touchZoom: true
      });

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '',
        maxZoom: 19,
        crossOrigin: true
      }).addTo(map);

      (mapEl as any)._leafletMap = map;
      (mapEl as any).dataset.initialized = 'true';

      setTimeout(() => map.invalidateSize(), 100);
      setTimeout(() => map.invalidateSize(), 500);
    });

    // Xử lý nút zoom
    document.querySelectorAll('.zoom-in').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const mapId = (btn as HTMLElement).dataset.map;
        const mapEl = document.getElementById(mapId!);
        if (mapEl && (mapEl as any)._leafletMap) {
          (mapEl as any)._leafletMap.zoomIn();
        }
      });
    });

    document.querySelectorAll('.zoom-out').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const mapId = (btn as HTMLElement).dataset.map;
        const mapEl = document.getElementById(mapId!);
        if (mapEl && (mapEl as any)._leafletMap) {
          (mapEl as any)._leafletMap.zoomOut();
        }
      });
    });

    window.addEventListener('resize', () => {
      document.querySelectorAll('.map-container').forEach((mapEl) => {
        if ((mapEl as any)._leafletMap) {
          (mapEl as any)._leafletMap.invalidateSize();
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllMaps);
  } else {
    initAllMaps();
  }
</script>